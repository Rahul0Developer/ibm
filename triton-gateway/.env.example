# ── Triton GPU Model Serving Gateway — environment template ──────────────
# Copy to .env and fill in real values.  NEVER commit the populated .env file.
#   cp .env.example .env

# Go gateway ------------------------------------------------------------------
GATEWAY_PORT=8080                 # HTTP/health/metrics listener
TRITON_GRPC_ADDR=localhost:8001   # Triton gRPC endpoint (HTTP/2)
TRITON_MODEL_NAME=text_embeddings
TRITON_MODEL_VERSION=1            # empty => Triton auto-selects latest version
REQUEST_DEADLINE_MS=25            # strict end-to-end SLA deadline per inference
MAX_CONCURRENT_REQUESTS=512       # admission-control semaphore size
GRPC_POOL_SIZE=4                  # pooled gRPC sub-connections to Triton
LOG_LEVEL=info                    # debug | info | warn | error

# Model pipeline (Python) -------------------------------------------------------
MODEL_ID=BAAI/bge-small-en-v1.5   # Hugging Face model exported to ONNX
OPSET_VERSION=17
EXPORT_DEVICE=cuda                # cuda | cpu
FP16_CONVERT=1                    # 1 => half-precision conversion after export

# S3 model hydration (init container / sync script) -----------------------------
AWS_REGION=us-east-1
S3_MODEL_BUCKET=s3://your-model-bucket/text_embeddings/
# AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY come from IRSA or the instance role.
# Never hard-code long-lived keys in manifests.
