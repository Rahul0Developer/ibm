# Copy to .env and fill in. NEVER commit the real .env (it is gitignored).
# All values below are placeholders; the app runs with zero configuration
# using safe defaults (LLM_PROVIDER=none, no BigQuery -> local fallback).

# --- general ---
ENVIRONMENT=dev
LOG_LEVEL=INFO
# Never log raw user text in production:
LOG_RAW_TEXT=false

# --- API ---
API_PORT=8080
CORS_ORIGINS=http://localhost:8501
RATE_LIMIT_PER_MINUTE=60
MAX_TEXT_LENGTH=5000

# --- models (local paths or HF Hub repo ids) ---
NER_MODEL_PATH=models/ner
CLF_MODEL_PATH=models/clf
# Hugging Face token for pushing/pulling private model repos (Colab secret / env only):
HF_TOKEN=

# --- RAG ---
# none | gemini | local   ("none" works end-to-end at $0 cost)
LLM_PROVIDER=none
# Gemini free-tier API key (https://aistudio.google.com/apikey). Keep empty unless used.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
CHROMA_DIR=data/processed/chroma
RAG_TOP_K=5

# --- BigQuery (leave GCP_PROJECT_ID empty to use the local DuckDB fallback) ---
GCP_PROJECT_ID=
BQ_DATASET=autovoice
BQ_TABLE=complaints
